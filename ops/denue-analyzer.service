# Snapshot of /etc/systemd/system/denue-analyzer.service.
#
# Install on a fresh VPS:
#   sudo cp ops/denue-analyzer.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now denue-analyzer.service
#
# The unit runs `npx tsx --env-file=.env scripts/serve.ts` from the repo root,
# binding to :3030 (overridable via API_PORT in .env). Caddy at
# uncharted.eurekamd.cloud proxies /api/* to this port (see ops/Caddyfile.uncharted).
#
# tsx caches in /tmp/tsx-0/, which PrivateTmp=yes (below) makes private to the
# unit and empty on every start. After source edits, `systemctl restart
# denue-analyzer` picks them up; deleting the host's /tmp/tsx-0/ does nothing.
#
# Logs: `journalctl -u denue-analyzer -f`

[Unit]
Description=DENUE Data Analyzer API (uncharted.eurekamd.cloud)
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
WorkingDirectory=/root/claude/projects/data-intelligence/denue-data-analysis
ExecStart=/usr/bin/npx tsx --env-file=.env scripts/serve.ts
Restart=always
RestartSec=5
TimeoutStopSec=10
StandardOutput=journal
StandardError=journal
SyslogIdentifier=denue-analyzer

EnvironmentFile=/root/claude/projects/data-intelligence/denue-data-analysis/.env
Environment=NODE_ENV=production
Environment=TZ=America/Mexico_City
# Behind Caddy (one trusted proxy): rate limits read the rightmost
# X-Forwarded-For entry instead of the loopback socket address. Keep
# TRUST_PROXY out of .env — EnvironmentFile would override this line.
Environment=TRUST_PROXY=1
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Sandboxing. On the live VPS these lines live in the drop-in
# /etc/systemd/system/denue-analyzer.service.d/hardening.conf.
# ProtectSystem=full (not strict) and no ProtectHome: the service runs from
# /root and the Claude Agent SDK writes ~/.claude, so strict or ProtectHome
# would break Sage. full still makes /usr, /boot and /etc (incl. /etc/caddy)
# read-only. PrivateTmp only means the tsx cache in /tmp starts empty on each
# restart. The docker socket (AF_UNIX) still works, so the psql/Sage
# `docker exec` path is unaffected; that socket is also why this still runs as
# root until the DB access moves to a least-privileged pg role over TCP.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=full
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK

[Install]
WantedBy=multi-user.target
