# Canonical snapshot of the Caddy block for /etc/caddy/Caddyfile.
# Audit 2026-09-26 (#4): the header{} block below was never deployed live
# (only the routes were); re-synced with the live block incl. /minisu-catalog.
# Audit W5 (2026-05-04): commit infra-as-code so VPS rebuilds are reproducible.
#
# To apply on a fresh VPS: append this block to /etc/caddy/Caddyfile,
# `caddy validate --config /etc/caddy/Caddyfile`, then
# `systemctl reload caddy` — Caddy auto-provisions LE TLS via HTTP-01.
#
# Prereqs:
#   - DNS A record: uncharted.eurekamd.cloud → <VPS_PUBLIC_IP>
#   - Backend running on localhost:3030 (`scripts/serve.ts`, tmux session `denue-api`)
#   - dist/ built via `cd web && npm run build`

# DENUE Analyzer — production dist/ + Hono backend on uncharted.eurekamd.cloud
# /api/* strips the prefix and proxies to Hono routes mounted at root.
# Static assets served from dist/ (built via `cd web && npm run build`),
# with SPA fallback to /index.html for client-side routing.
# Audit P3-perf C fix (2026-05-04): switched from Vite dev (~1500 module
# fetches per cold load) to dist/ (single chunk + lazy MapMode chunk).
# Vite dev still runs on :5173 for local HMR; not exposed publicly.
uncharted.eurekamd.cloud {
	encode zstd gzip
	# Audit W2-sec round-1 closure 2026-05-10: defense-in-depth headers.
	# X-Frame-Options DENY      — block clickjacking embed in another origin
	# X-Content-Type-Options    — block MIME-sniffing of dist/ assets
	# Referrer-Policy           — minimal cross-origin leakage
	# Permissions-Policy        — opt out of unused browser features
	# Strict-Transport-Security — force HTTPS for 1y (LE TLS already on)
	# CSP (audit 2026-09-26 #4/#194) ships REPORT-ONLY first: switch the name to
	# Content-Security-Policy once /map (Carto tiles/glyphs/sprites, MapLibre
	# blob: workers) and the Supabase login on db.mycommit.net run clean.
	header {
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=()"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.basemaps.cartocdn.com; connect-src 'self' https://db.mycommit.net https://basemaps.cartocdn.com https://*.basemaps.cartocdn.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; object-src 'none'"
		# Hide upstream tooling fingerprint
		-Server
	}
	# Audit 2026-09-26 #5: agent-writable jarvis-kb dir on the SPA's origin.
	# CSP sandbox gives its pages an opaque origin (no access to the SPA's
	# localStorage session). Follow-up: move to its own host once DNS exists.
	handle_path /minisu-catalog/* {
		header Content-Security-Policy "sandbox"
		header X-Content-Type-Options "nosniff"
		root * /root/claude/jarvis-kb/workspace/minisu-sku-images
		file_server
	}
	handle_path /api/* {
		reverse_proxy localhost:3030
	}
	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		# Audit 2026-09-26 #12/#190/#196: never serve sourcemaps (vite no longer
		# emits them; this guards a stale dist/). Inside this handle on purpose:
		# a site-level `handle @maps` sorts AFTER `handle /assets/*` (shorter
		# path) and a site-level `respond` runs after every handle, so both
		# still served the .map with 200. Within a handle, respond precedes
		# file_server.
		@maps path *.map
		respond @maps 404
		root * /root/claude/projects/data-intelligence/denue-data-analysis/web/dist
		file_server
	}
	handle {
		# Deploy 2026-09-27: a tab that kept a cached index.html after the web
		# build asked for a chunk the new build no longer has. Assets are
		# immutable (hashed), so the index must always revalidate.
		header Cache-Control "no-cache"
		root * /root/claude/projects/data-intelligence/denue-data-analysis/web/dist
		try_files {path} /index.html
		file_server
	}
}
